// Forum data model.
// Docs: https://pris.ly/d/prisma-schema
// Prisma 7 `prisma-client` generator → output to src/generated/prisma (gitignored).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

// Guest is an unauthenticated visitor and is therefore NOT stored.
// Stored roles are the authenticated tiers.
enum Role {
  USER
  MODERATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  ARCHIVED
}

enum AdPlacement {
  TOP_PANEL
  SIDEBAR
}

// ---------------------------------------------------------------------------
// Users & profiles
// ---------------------------------------------------------------------------

model User {
  id           String     @id @default(cuid())
  // Auth + contact (hidden from other users)
  email        String     @unique
  phone        String
  passwordHash String
  role         Role       @default(USER)
  status       UserStatus @default(ACTIVE)

  // Brute-force lockout: consecutive failed logins, and until when the account
  // refuses password checks once the threshold is hit. Reset on success.
  failedLogins Int       @default(0)
  lockedUntil  DateTime?

  // The "main admin" / owner — always sees real authors behind anonymous
  // content and controls whether other staff can. Typically just one user.
  isOwner Boolean @default(false)

  // Paid "Donor" tier — orthogonal to role (any user can be a Donor). Grants
  // access to perks like the "Ask AI" feature. Admin-granted for now; will be
  // driven by Stripe subscriptions later.
  isDonor Boolean @default(false)

  // Paid "Professional" (პრო) tier — also subscription-based. Grants the same
  // AI access as Donor, plus the ability to register a business account.
  isPro Boolean @default(false)

  // Paid "Supporter" (მხარდამჭერი) tier — the entry-level donation bracket.
  // Deliberately does NOT grant AI access; it unlocks profile and feed
  // customization only. Donor and Pro include everything it offers.
  isSupporter Boolean @default(false)

  // --- Appearance preferences (the Supporter "feed customization" perk) ---
  // These only change what THIS user sees; nothing here is public, so none of
  // it is a moderation surface. Stored on the user row rather than in the
  // browser because getCurrentUser() already selects this row on every
  // request, making the read free, and because it should follow the user
  // across devices.
  //
  // NOTE: accessibility-affecting settings must never live behind the paid
  // gate (see FREE_PREFS in src/lib/appearance.ts).
  themePalette String  @default("default") // curated preset, or "custom"
  themeAccent  String? // hex, only used when themePalette == "custom"
  themeDensity String  @default("comfortable") // comfortable | compact
  themeRadius  String  @default("rounded") // rounded | soft | square
  themeDepth   String  @default("full") // full | subtle | flat

  // Per-moderator grant: lets this moderator open the (moderation-only) admin
  // panel. Admins always have access; plain users never do, regardless of flag.
  canAccessAdmin Boolean @default(false)

  // Per-staff grant: lets this moderator/admin see the real author behind
  // anonymous content. The owner always can; others only when granted here.
  canRevealAnon Boolean @default(false)

  // Public-facing identity
  forumName String @unique // "Name on the forum"

  // Real name — mandatory, but the user may hide it from other users
  firstName    String
  lastName     String
  hideRealName Boolean @default(false)

  // Location
  city  String?
  state String

  // Relations
  posts                Post[]
  replies              Reply[]
  postVotes            PostVote[]
  replyVotes           ReplyVote[]
  moderatedCategories  Category[]                @relation("CategoryModerators")
  labels               Label[]                   @relation("UserLabels")
  savedPosts           SavedPost[]
  businesses           Business[]                @relation("BusinessOwner")
  managedBusinesses    BusinessManager[]         @relation("BusinessManagerUser")
  businessReviews      BusinessReview[]
  propertyListings     PropertyListing[]         @relation("ListingOwner")
  uploads              MediaUpload[]
  marketListings       MarketListing[]           @relation("MarketSeller")
  marketFavorites      MarketFavorite[]
  sellerReviews        MarketSellerReview[]      @relation("SellerReviews")
  sellerReviewsWritten MarketSellerReview[]      @relation("SellerReviewsWritten")
  reportsResolved      Report[]                  @relation("ReportResolver")
  merchOrders          MerchOrder[]
  autoListings         AutoListing[]             @relation("AutoOwner")
  jobPostings          JobPosting[]              @relation("JobPoster")
  notifications        Notification[]            @relation("UserNotifications")
  notificationsActed   Notification[]            @relation("NotificationActor")
  conversations        ConversationParticipant[]
  messagesSent         Message[]                 @relation("MessageSender")
  blocksMade           Block[]                   @relation("Blocker")
  blocksReceived       Block[]                   @relation("Blocked")
  reportsMade          Report[]                  @relation("Reporter")
  reportsAbout         Report[]                  @relation("ReportedUser")

  // Moderation bookkeeping (content this user hid, when acting as mod/admin)
  hiddenPosts   Post[]         @relation("PostHiddenBy")
  hiddenReplies Reply[]        @relation("ReplyHiddenBy")
  aiUsage       AiUsage[]
  aiBalance     AiBalance?
  subscriptions Subscription[]
  packages      UserPackage[]
  authTokens    AuthToken[]
  auditEntries  AuditLog[]     @relation("AuditActor")
  eventRsvps    EventRsvp[]

  // Email confirmation. New signups start false and get a verification email;
  // access is not blocked (soft nudge — a dismissible banner). Existing accounts
  // are grandfathered to true in the migration, since they predate this.
  emailVerified Boolean @default(false)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  // Last time the user loaded a page — drives the live "online" count.
  lastSeenAt DateTime?

  @@index([role])
  @@index([lastSeenAt])
}

// ---------------------------------------------------------------------------
// Categories
// ---------------------------------------------------------------------------

model Category {
  id   String @id @default(cuid())
  slug String @unique

  // Localized names/descriptions (EN + KA). Admin-managed from the admin panel.
  nameEn        String
  nameKa        String
  descriptionEn String?
  descriptionKa String?

  // Locked categories: name is visible to guests, content is gated behind login.
  locked Boolean @default(false)

  // Display order in sidebar / categories page
  sortOrder Int @default(0)

  posts      Post[]
  moderators User[] @relation("CategoryModerators")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Posts
// ---------------------------------------------------------------------------

// Discussions and Events share one table: an Event *is* a Post, so replies,
// votes, saves, reports, moderation, anonymous posting and business authorship
// all work on it unchanged. The event-only columns are null on a discussion.
enum PostKind {
  DISCUSSION
  EVENT
  // The Q&A thread behind a job listing. It is a Post so questions reuse the
  // whole reply system — nesting, votes, anonymous authors, moderation,
  // reports, notifications — but it belongs to the job page, so it is kept out
  // of the feed, search and the popular bar (see lib/post-kinds.ts).
  JOB
}

model Post {
  id    String   @id @default(cuid())
  slug  String   @unique
  title String
  kind  PostKind @default(DISCUSSION)

  // --- Events only (null on discussions) ---------------------------------
  // Times are stored as the wall-clock the organiser typed, normalised to UTC
  // and always rendered in UTC. An event happens at a place, so "19:00" means
  // 19:00 at that venue for everyone reading — no silent per-viewer shifting.
  eventStartsAt DateTime?
  eventEndsAt   DateTime? // optional: open-ended events just have a start
  eventLocation String? // free text: venue, address or "online"
  eventUrl      String? // optional tickets / registration / meeting link

  rsvps EventRsvp[]

  // Set when kind = JOB: the listing this thread answers questions for.
  jobListing JobPosting? @relation("JobDiscussion")

  // Rich text body stored as JSON (editor document) so it can hold media,
  // links, lists, quotes, etc.
  body Json

  author     User     @relation(fields: [authorId], references: [id])
  authorId   String
  category   Category @relation(fields: [categoryId], references: [id])
  categoryId String

  // Anonymous posting: null = posted as the real author; 1/2/3 = which of the
  // author's 3 generated anonymous aliases. authorId is always kept for
  // moderation (revealed only to authorized staff).
  anonAlias Int?

  // Posted while "acting as" a business the author manages: the post is
  // attributed to the business (name/logo/link), while authorId still records
  // the human who wrote it (for moderation). Mutually exclusive with anonAlias.
  authorBusiness   Business? @relation("PostBusinessAuthor", fields: [authorBusinessId], references: [id], onDelete: SetNull)
  authorBusinessId String?

  // Quick-posted from the home composer: auto-filed under Discussions, flagged
  // so it shows a "may be moved to a fitting community" notice for moderators.
  quickPosted Boolean @default(false)

  // Admin-curated: pinned into the Popular Topics bar. When any posts are
  // featured, the bar shows those (instead of the automatic top-by-score list).
  featuredInBar Boolean @default(false)

  // Moderation: hidden (not deleted) content stays on the server; admins can see it.
  hidden     Boolean   @default(false)
  hiddenBy   User?     @relation("PostHiddenBy", fields: [hiddenById], references: [id])
  hiddenById String?
  hiddenAt   DateTime?

  // Moderators can lock replies on a post.
  repliesLocked Boolean @default(false)

  // Denormalized net vote score (sum of PostVote.value), kept in sync on vote.
  score Int @default(0)

  replies      Reply[]
  votes        PostVote[]
  savedBy      SavedPost[]
  dmReferences Message[]   @relation("MessagePostRef")
  reports      Report[]

  // Cached AI summary of the thread (regenerated when newer activity appears).
  aiSummary   String?
  aiSummaryAt DateTime?

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastActivity DateTime @default(now()) // for "most recently discussed"

  @@index([categoryId, lastActivity])
  @@index([hidden])
  @@index([featuredInBar])
  @@index([kind, eventStartsAt])
}

// ---------------------------------------------------------------------------
// Replies (threaded comments)
// ---------------------------------------------------------------------------

model Reply {
  id   String @id @default(cuid())
  body Json

  author   User   @relation(fields: [authorId], references: [id])
  authorId String
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String

  // Anonymous reply: null = real author; 1/2/3 = which generated alias.
  anonAlias Int?

  // Replied while acting as a business (see Post.authorBusinessId).
  authorBusiness   Business? @relation("ReplyBusinessAuthor", fields: [authorBusinessId], references: [id], onDelete: SetNull)
  authorBusinessId String?

  // Self-relation for nested threads.
  parent   Reply?  @relation("ReplyThread", fields: [parentId], references: [id])
  parentId String?
  children Reply[] @relation("ReplyThread")

  hidden     Boolean   @default(false)
  hiddenBy   User?     @relation("ReplyHiddenBy", fields: [hiddenById], references: [id])
  hiddenById String?
  hiddenAt   DateTime?

  // Author-deleted replies that still have children become tombstones (the
  // sub-thread is preserved); leaf replies are hard-deleted instead.
  deletedAt DateTime?

  // Denormalized net vote score (sum of ReplyVote.value).
  score Int @default(0)

  votes   ReplyVote[]
  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([parentId])
}

// ---------------------------------------------------------------------------
// Votes (+ / -) on posts and replies
// ---------------------------------------------------------------------------

model PostVote {
  id     String @id @default(cuid())
  value  Int // +1 or -1
  user   User   @relation(fields: [userId], references: [id])
  userId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String

  createdAt DateTime @default(now())

  @@unique([userId, postId])
}

model ReplyVote {
  id      String @id @default(cuid())
  value   Int // +1 or -1
  user    User   @relation(fields: [userId], references: [id])
  userId  String
  reply   Reply  @relation(fields: [replyId], references: [id], onDelete: Cascade)
  replyId String

  createdAt DateTime @default(now())

  @@unique([userId, replyId])
}

// ---------------------------------------------------------------------------
// Advertisement cards (managed by admins from the admin panel)
// ---------------------------------------------------------------------------

model AdCard {
  id         String      @id @default(cuid())
  titleEn    String
  titleKa    String
  // Hex color for the title overlaid on the card image — admin-editable so the
  // title stays legible against whatever image is used.
  titleColor String      @default("#ffffff")
  // Title font size in px (admin-editable).
  titleSize  Int         @default(16)
  imageUrl   String?
  videoUrl   String? // direct video file URL (mp4/webm); takes priority over image
  linkUrl    String?
  placement  AdPlacement @default(TOP_PANEL)
  active     Boolean     @default(true)
  sortOrder  Int         @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([placement, active, sortOrder])
}

// ---------------------------------------------------------------------------
// Labels — admin-created badges that can be assigned to users. The built-in
// "Donor" badge is NOT a Label (it's derived from User.isDonor); these are the
// extra, fully customizable labels admins manage here.
// ---------------------------------------------------------------------------

model Label {
  id     String @id @default(cuid())
  nameEn String
  nameKa String

  // Badge styling, admin-controlled.
  color      String  @default("#1f4e9c") // text/foreground
  background String  @default("#eaf1fb") // badge background
  font       String  @default("body") // "body" | "display"
  bold       Boolean @default(true)

  sortOrder Int @default(0)

  users User[] @relation("UserLabels")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([sortOrder])
}

// ---------------------------------------------------------------------------
// Site settings — a single-row table of global toggles (owner-controlled).
// ---------------------------------------------------------------------------

// Saved/bookmarked posts (per user).
// One row per member per event. Three states rather than a boolean so
// "interested" is distinguishable from "not going" and from no answer at all.
enum RsvpStatus {
  GOING
  INTERESTED
  NOT_GOING
}

model EventRsvp {
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  status RsvpStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([postId, userId])
  @@index([postId, status])
  @@index([userId, createdAt])
}

model SavedPost {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  createdAt DateTime @default(now())

  @@id([userId, postId])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Business accounts — registered by Professional-tier users. One Pro user can
// own many businesses. Surfaced in a public directory; supports reviews and
// job postings; admins can verify and feature them.
// ---------------------------------------------------------------------------

model Business {
  id      String @id @default(cuid())
  slug    String @unique
  owner   User   @relation("BusinessOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  name        String
  tagline     String? // short one-liner
  description String? // longer plain-text blurb
  category    String // key from the curated business-categories list
  logoUrl     String?

  // Storefront gallery: ordered image URLs, photos[0] is the cover shown on the
  // directory card. Separate from logoUrl, which stays the small square mark.
  photos      String[]

  // Location — reuses the State/Country picker values (US state abbr, "US", "GE").
  city  String?
  state String

  // Contact
  website String?
  email   String?
  phone   String?

  // Admin-controlled flags
  verified Boolean @default(false) // admin-verified authentic business
  featured Boolean @default(false) // promoted: pinned to top of the directory

  // Denormalized rating aggregate (kept in sync on review writes).
  ratingCount Int @default(0)
  ratingSum   Int @default(0)

  reviews BusinessReview[]
  jobs    JobPosting[]

  // Additional forum users the owner has delegated to manage this business.
  managers BusinessManager[]

  // Content this business has authored while someone acted as it.
  authoredPosts   Post[]          @relation("PostBusinessAuthor")
  authoredReplies Reply[]         @relation("ReplyBusinessAuthor")
  marketListings  MarketListing[] @relation("MarketSellerBusiness")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([state])
  @@index([featured])
}

// Delegated management: forum users (besides the owner) allowed to act as and
// manage a business. The owner isn't listed here — ownership is Business.ownerId;
// canManageBusiness() checks owner OR a row here OR admin.
model BusinessManager {
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  user       User     @relation("BusinessManagerUser", fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  createdAt  DateTime @default(now())

  @@id([businessId, userId])
  @@index([userId])
}

model BusinessReview {
  id         String   @id @default(cuid())
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId   String

  rating Int // 1..5
  body   String?

  // The business's public reply to this piece of feedback (owner/manager).
  ownerReply   String?
  ownerReplyAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([businessId, authorId]) // one review per user per business
  @@index([businessId])
}

model JobPosting {
  id         String    @id @default(cuid())
  // Either a business posting (businessId) or a member posting (posterId).
  business   Business? @relation(fields: [businessId], references: [id], onDelete: Cascade)
  businessId String?
  poster     User?     @relation("JobPoster", fields: [posterId], references: [id], onDelete: Cascade)
  posterId   String?

  title        String
  description  String
  // Member postings carry the employer + contact details a business
  // profile would otherwise provide.
  companyName  String?
  jobType      String? // FULL_TIME | PART_TIME | CONTRACT | TEMPORARY | GIG
  pay          String? // free text, e.g. "$18/hr" or "from $60k"
  contactEmail String?
  contactPhone String?
  city         String?
  state        String?
  active       Boolean @default(true)

  // The Q&A thread for this listing, created the first time its page is
  // opened. Nullable so the jobs that existed before Q&A shipped stay valid.
  discussion   Post?   @relation("JobDiscussion", fields: [discussionId], references: [id], onDelete: SetNull)
  discussionId String? @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, createdAt])
  @@index([businessId])
  @@index([posterId])
}

// ---------------------------------------------------------------------------
// Real estate — sale & rental listings, posted by Professional-tier users
// (same perk bracket as business profiles and job postings). Public directory
// with search filters; each listing has a photo gallery, feature checklist,
// address (linked to Google Maps) and contact details.
// ---------------------------------------------------------------------------

model PropertyListing {
  id      String @id @default(cuid())
  slug    String @unique
  owner   User   @relation("ListingOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  kind         String // "SALE" | "RENT"
  propertyType String // key from the curated property-types list (lib/estate.ts)
  title        String
  description  String?

  // Whole dollars. For RENT this is the monthly rate.
  price Int

  // Facts — all optional so land/commercial listings aren't forced to lie.
  bedrooms  Int?
  bathrooms Int?
  rooms     Int? // total rooms
  areaSqFt  Int?
  yearBuilt Int?

  // Location — street address is required (it feeds the map view); state reuses
  // the profile State/Country picker values.
  address String
  city    String?
  zip     String? // optional; powers the ZIP + radius search
  state   String

  // Centroid of `zip`, filled server-side on save. Null when no ZIP is given,
  // which means the listing can't match a radius search.
  lat Float?
  lng Float?

  features String[] // keys from the curated features list (lib/estate.ts)
  photos   String[] // ordered image URLs; photos[0] is the hero shot

  // Admin-curated banner on the real-estate page: featured listings, in
  // featuredOrder. Views feed the admin dashboard.
  featured      Boolean @default(false)
  featuredOrder Int     @default(0)
  views         Int     @default(0)

  reports Report[]

  // Contact — profile is implicit (the owner); these are extra channels.
  contactName String?
  phone       String?
  email       String?

  active Boolean @default(true) // owner can unlist without deleting

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([propertyType])
  @@index([state])
  @@index([active, createdAt])
  @@index([lat, lng])
}

// ---------------------------------------------------------------------------
// Marketplace — member-to-member classifieds (goods for sale, free items).
// Free for everyone today; canSellOnMarket() in lib/perks.ts is the switch
// that makes selling a paid perk later. A listing can be attributed to a
// business when the seller was acting as one.
// ---------------------------------------------------------------------------

model MarketListing {
  id       String @id @default(cuid())
  slug     String @unique
  seller   User   @relation("MarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId String

  sellerBusiness   Business? @relation("MarketSellerBusiness", fields: [sellerBusinessId], references: [id], onDelete: SetNull)
  sellerBusinessId String?

  title       String
  description String
  category    String // key from lib/market.ts
  condition   String // NEW | LIKE_NEW | GOOD | FAIR | PARTS

  // Whole dollars. 0 when priceType is FREE.
  price     Int
  priceType String @default("FIXED") // FIXED | NEGOTIABLE | FREE

  photos String[] // ordered; [0] is the cover

  // Where the item is; how the buyer can get it.
  city          String?
  zip           String? // optional; powers the ZIP + radius search
  state         String
  localPickup   Boolean @default(true)
  localDelivery Boolean @default(false) // seller drops it off nearby
  canShip       Boolean @default(false)

  // Centroid of `zip`, filled server-side on save (null = no radius match).
  lat Float?
  lng Float?

  phone String? // optional extra contact; DMs are always available

  // ACTIVE | SOLD | PAUSED | REMOVED. Search shows ACTIVE only, and only
  // listings renewed within the last 60 days (see MARKET_EXPIRY_DAYS).
  // REMOVED is set by staff (from a report); the seller can't relist it.
  status        String   @default("ACTIVE")
  removedReason String?
  bumpedAt      DateTime @default(now()) // "renew" moves this forward
  views         Int      @default(0)

  favorites     MarketFavorite[]
  reports       Report[]
  sellerReviews MarketSellerReview[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, bumpedAt])
  @@index([category])
  @@index([state])
  @@index([sellerId])
  @@index([lat, lng])
}

model MarketFavorite {
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  listing   MarketListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId String
  createdAt DateTime      @default(now())

  @@id([userId, listingId])
  @@index([listingId])
}

// Seller reputation: one rating per reviewer per seller, editable. Only
// members who have actually messaged the seller can rate (see rateSeller),
// which keeps drive-by ratings out.
model MarketSellerReview {
  id         String         @id @default(cuid())
  seller     User           @relation("SellerReviews", fields: [sellerId], references: [id], onDelete: Cascade)
  sellerId   String
  reviewer   User           @relation("SellerReviewsWritten", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerId String
  listing    MarketListing? @relation(fields: [listingId], references: [id], onDelete: SetNull)
  listingId  String? // which item the deal was about, if any

  rating Int // 1..5
  body   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([sellerId, reviewerId])
  @@index([sellerId, createdAt])
}

// ---------------------------------------------------------------------------
// Forum merchandise — the official shop, run by admins. Products carry
// variants (size/colour) with their own stock; members place orders that
// staff move through a pipeline. Payment is settled off-platform for now
// (staff mark orders paid); MerchOrder.paymentMethod is the seam for Stripe.
// ---------------------------------------------------------------------------

model MerchProduct {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String
  category    String   @default("apparel") // apparel | accessories | home | other
  priceCents  Int // base price; variants can add a delta
  photos      String[]
  active      Boolean  @default(true) // sellable / visible in the shop
  featured    Boolean  @default(false) // shown in the marketplace top strip
  sortOrder   Int      @default(0)

  variants MerchVariant[]
  items    MerchOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active, sortOrder])
}

model MerchVariant {
  id              String       @id @default(cuid())
  product         MerchProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
  productId       String
  label           String // "S", "M", "Black / L", …
  sku             String?
  stock           Int          @default(0)
  priceDeltaCents Int          @default(0)
  sortOrder       Int          @default(0)
  active          Boolean      @default(true)

  items MerchOrderItem[]

  @@index([productId, sortOrder])
}

model MerchOrder {
  id     String @id @default(cuid())
  number Int    @unique @default(autoincrement()) // human-friendly order number

  buyer   User?   @relation(fields: [buyerId], references: [id], onDelete: SetNull)
  buyerId String?

  // NEW → CONFIRMED → PAID → SHIPPED → DELIVERED, or CANCELLED at any point.
  status String @default("NEW")

  contactName     String
  email           String
  phone           String?
  shippingAddress String
  note            String? // buyer's note

  subtotalCents Int
  shippingCents Int @default(0)
  totalCents    Int

  paymentMethod  String? // "offline" for now
  paidAt         DateTime?
  shippedAt      DateTime?
  trackingNumber String?
  adminNote      String?

  items MerchOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, createdAt])
  @@index([buyerId])
}

model MerchOrderItem {
  id        String        @id @default(cuid())
  order     MerchOrder    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   String
  product   MerchProduct? @relation(fields: [productId], references: [id], onDelete: SetNull)
  productId String?
  variant   MerchVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)
  variantId String?

  // Snapshots, so the order still reads after a product changes or goes away.
  name         String
  variantLabel String?
  unitCents    Int
  quantity     Int

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Auto market — cars for sale and for rent. Built on the real-estate and
// marketplace patterns: ZIP-resolved coordinates for radius search, a curated
// feature checklist, an admin-curated featured banner, and a staff REMOVED
// state driven from reports. Rentals price per day and carry insurance /
// deposit / minimum-days facts that sales don't need.
// ---------------------------------------------------------------------------

model AutoListing {
  id      String @id @default(cuid())
  slug    String @unique
  owner   User   @relation("AutoOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId String

  kind String // "SALE" | "RENT"

  // Identity — title is derived ("2019 Toyota Camry") and stored for search.
  year      Int
  make      String // key from lib/auto.ts (or "other" + makeOther)
  makeOther String?
  model     String
  title     String

  bodyType     String? // key from lib/auto.ts
  mileage      Int?
  transmission String? // AUTOMATIC | MANUAL
  fuel         String? // GAS | DIESEL | HYBRID | ELECTRIC
  drivetrain   String? // FWD | RWD | AWD | FOURWD
  color        String?
  condition    String  @default("USED") // NEW | USED (sales)
  vin          String?

  // Whole dollars. For RENT this is the daily rate.
  price      Int
  negotiable Boolean @default(false)

  // Rental-only facts
  insured       Boolean @default(false)
  minRentalDays Int?
  depositAmount Int?

  description String?
  features    String[] // keys from lib/auto.ts
  photos      String[] // ordered; [0] is the cover

  // Location — ZIP is optional but powers the radius search.
  city  String?
  zip   String?
  state String
  lat   Float?
  lng   Float?

  contactName String?
  phone       String?
  email       String?

  // ACTIVE | SOLD (or rented out) | PAUSED | REMOVED (staff)
  status        String  @default("ACTIVE")
  removedReason String?

  featured      Boolean @default(false)
  featuredOrder Int     @default(0)
  views         Int     @default(0)

  reports Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
  @@index([make])
  @@index([status, createdAt])
  @@index([state])
  @@index([lat, lng])
  @@index([ownerId])
}

// ---------------------------------------------------------------------------
// Visitor counter. Cookieless and non-identifying: `hash` is a salted digest
// of IP + user-agent that rotates every day, so it cannot be used to follow
// anyone across days and needs no consent banner. One row per visitor per day
// gives "unique visitors in the last N days" by counting distinct hashes.
// ---------------------------------------------------------------------------

model VisitorDay {
  hash String
  day  String // YYYY-MM-DD (UTC)

  @@id([hash, day])
  @@index([day])
}

// ---------------------------------------------------------------------------
// Uploaded media ledger. Every object written to Spaces through /api/upload
// gets a row here, so uploads are attributable (who, when, how big), quota-
// limitable (rolling 24h per user), and erasable: when the post/listing/ad
// that referenced a URL is deleted, the object is removed from the bucket.
// ---------------------------------------------------------------------------

model MediaUpload {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  key         String   @unique // object key inside the bucket
  url         String   @unique // public URL as handed to the client
  contentType String
  size        Int // bytes
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Inbox — notifications (activity about you) + direct messages (1:1 chat).
// ---------------------------------------------------------------------------

model Notification {
  id     String @id @default(cuid())
  user   User   @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  userId String // recipient

  type String // "reply" | "mention" | "review" | "system"

  // Who triggered it (null for system/anonymous).
  actor   User?   @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId String?

  title String // short snapshot, e.g. the related post/business title
  body  String? // optional snippet
  url   String // locale-less relative target, e.g. "/p/some-slug"

  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId, read, createdAt])
}

model Conversation {
  id            String   @id @default(cuid())
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  participants ConversationParticipant[]
  messages     Message[]

  @@index([lastMessageAt])
}

model ConversationParticipant {
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  lastReadAt     DateTime?

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String       @id @default(cuid())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  sender         User         @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  senderId       String
  body           String

  // Optional referenced post ("about this listing"). Kept if the post is later
  // deleted (the reference just goes null).
  post   Post?   @relation("MessagePostRef", fields: [postId], references: [id], onDelete: SetNull)
  postId String?

  createdAt DateTime @default(now())

  @@index([conversationId, createdAt])
}

// Block: blocker can no longer exchange DMs with the blocked user (either way).
model Block {
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
  @@index([blockedId])
}

// Report: a member flags another member (optionally from a DM) for staff review.
model Report {
  id                String           @id @default(cuid())
  reporter          User             @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId        String
  reportedUser      User?            @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  reportedUserId    String?
  conversationId    String? // context, if reported from a DM
  post              Post?            @relation(fields: [postId], references: [id], onDelete: SetNull)
  postId            String? // set when a post is reported
  reply             Reply?           @relation(fields: [replyId], references: [id], onDelete: SetNull)
  replyId           String? // set when a reply is reported
  marketListing     MarketListing?   @relation(fields: [marketListingId], references: [id], onDelete: SetNull)
  marketListingId   String? // set when a marketplace listing is reported
  propertyListing   PropertyListing? @relation(fields: [propertyListingId], references: [id], onDelete: SetNull)
  propertyListingId String? // set when a real-estate listing is reported
  autoListing       AutoListing?     @relation(fields: [autoListingId], references: [id], onDelete: SetNull)
  autoListingId     String? // set when an auto listing is reported
  reason            String?
  context           String? // snapshot, e.g. the last message
  status            String           @default("OPEN") // OPEN | RESOLVED | DISMISSED

  // Staff bookkeeping: who closed it, when, and a short note for the record.
  note         String?
  resolvedBy   User?     @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([status, createdAt])
  @@index([marketListingId])
}

model SiteSetting {
  id String @id @default("singleton")

  // When true, all admins/moderators can see the real author behind anonymous
  // content. When false, only the owner can. Controlled by the owner.
  revealAnonymousToStaff Boolean @default(false)

  // Total items shown in the Popular Topics bar (posts + ad cards combined).
  popularBarSize Int @default(6)

  // Visits recorded before the built-in counter existed (taken from Google
  // Analytics). Added to the public figure so it reflects the whole history
  // rather than restarting from the day the counter shipped.
  visitorBaseline Int @default(0)

  // Who may post in each listing area: "all" = any registered member,
  // "perk" = only holders of the matching perk (Pro, or a package carrying
  // the feature key — realEstate / market / auto / jobPosting). Managed from
  // Admin → pricing, so the areas can become paid without a deploy.
  postingEstate   String @default("all")
  postingMarket   String @default("all")
  postingAuto     String @default("all")
  postingJobs     String @default("all")
  // The business registry uses the same modes. Default "all": any signed-in
  // member may register one. Switch to "perk" to make it Professional-only.
  postingBusiness String @default("all")

  // Who may create Events. Starts at "verified" (a confirmed email address);
  // an admin can widen it to every member, narrow it to staff, or tie it to a
  // tag or a paid perk — see lib/event-access.ts. eventsLabelId names the tag
  // when the mode is "label".
  eventsMode    String  @default("verified")
  eventsLabelId String?

  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// AI usage log — one row per LLM call, for admin cost tracking. Per-user
// budget caps come later; for now this is observability only.
// ---------------------------------------------------------------------------
// AI packages: how much AI a user gets, decided by the subscription they hold.
// Admin-editable from /admin/ai-usage, so allowances can be tuned without a
// deploy (and dialled to 0 to switch a tier's AI off entirely).
//
// Credits are pegged to real spend (creditMicroUsd) rather than call counts,
// because a long question costs far more than a short one — counting calls
// would leave the Anthropic bill unbounded.
model AiPackage {
  id     String @id @default(cuid())
  key    String @unique // "AI_USER" | "AI_DONOR" | "AI_PRO"
  nameEn String
  nameKa String

  // Subscription tier this package is obtained through. null = granted to
  // nobody (AI_USER ships this way as a placeholder until Supporters get it).
  tier String? // "SUPPORTER" | "DONOR" | "PRO"

  // Off means the tier gets no AI at all, regardless of the numbers below.
  isActive Boolean @default(true)

  // Monthly allowance in micro-USD (USD × 1_000_000). Admin enters dollars.
  // Pegged to real spend rather than a call count, because a long question
  // costs far more than a short one.
  monthlyBudgetMicroUsd Int @default(0)

  // Share of an unused allowance carried into the next calendar month, so a
  // light month is not simply confiscated. 0 = use it or lose it.
  rolloverPercent Int @default(50)

  sortOrder Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Per-user token bucket. Deliberately has no cron: `credits` is the balance as
// of `lastRefillAt`, and accrual since then is computed on read (the same
// derive-on-read trick used for discount expiry in lib/packages.ts).
model AiBalance {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // All amounts in micro-USD. `balance` is the value as of `lastRefillAt`;
  // accrual since then is derived on read.
  balanceMicroUsd Float    @default(0)
  lastRefillAt    DateTime @default(now())

  // Package the balance last accrued under; a tier change re-clamps to the
  // new ceiling instead of silently keeping an oversized balance.
  packageKey String?

  // Calendar-month window driving the "used X%" figures and the rollover.
  spentThisPeriodMicroUsd Float    @default(0)
  carriedInMicroUsd       Float    @default(0)
  periodStartedAt         DateTime @default(now())

  updatedAt DateTime @updatedAt
}

model AiUsage {
  id     String  @id @default(cuid())
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  kind  String // "summary" | "ask"
  model String // resolved Claude model id

  tokensIn     Int
  tokensOut    Int
  // Cost in micro-USD (USD × 1_000_000) computed from model pricing at call time.
  costMicroUsd Int

  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Paid packages shown on the "მეტი" page. Everything marketing-facing — price,
// discount, copy, perk list, ordering, active state — lives here rather than in
// code, so an admin can change the offer without a deploy.
//
// The three original tiers (SUPPORTER / DONOR / PRO) are seeded as built-ins and
// stay mirrored onto User.isSupporter/isDonor/isPro, so all existing gating
// keeps working. Admin-created packages are granted through UserPackage and gate
// via their feature keys instead.
enum DiscountType {
  PERCENT // e.g. 20% off
  FIXED // e.g. flat $3.50 while the promo runs
}

model PaidPackage {
  id        String  @id @default(cuid())
  key       String  @unique // "SUPPORTER" | "DONOR" | "PRO" | generated
  slug      String  @unique // public route: /[lang]/<slug>
  isBuiltIn Boolean @default(false) // built-ins can be edited but not deleted

  nameEn  String
  nameKa  String
  blurbEn String // one-liner on the card
  blurbKa String
  pitchEn String // paragraph on the package's own page
  pitchKa String

  icon   String @default("✦")
  accent String @default("#1f4e9c")

  priceCents Int @default(0)

  // Discount is optional and per-package: the admin picks a percentage or a
  // flat promo price. Whether it is live is derived from the window on read,
  // so a discount starts and expires on its own with no scheduled job.
  discountType       DiscountType?
  discountPercent    Int?
  discountPriceCents Int?
  discountStartsAt   DateTime?
  discountEndsAt     DateTime?

  isActive  Boolean @default(true) // hidden from the public page when false
  featured  Boolean @default(false) // draws the "most popular" flag
  sortOrder Int     @default(0)

  features PackageFeature[]
  grants   UserPackage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
}

// Catalogue of perk lines, shared across packages so the same perk reads
// identically everywhere. `key` is what gating looks up (e.g. "askAi").
model Feature {
  id        String           @id @default(cuid())
  key       String           @unique
  nameEn    String
  nameKa    String
  isActive  Boolean          @default(true)
  sortOrder Int              @default(0)
  packages  PackageFeature[]
  createdAt DateTime         @default(now())

  @@index([isActive, sortOrder])
}

// Which perks a package lists. `included: false` renders struck through — used
// to spell out what a cheaper package deliberately leaves out (e.g. no AI).
model PackageFeature {
  package   PaidPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String
  feature   Feature     @relation(fields: [featureId], references: [id], onDelete: Cascade)
  featureId String
  included  Boolean     @default(true)
  sortOrder Int         @default(0)

  @@id([packageId, featureId])
  @@index([featureId])
}

// Generic package ownership, so admin-created packages can be granted too.
model UserPackage {
  id        String      @id @default(cuid())
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  package   PaidPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  packageId String
  grantedAt DateTime    @default(now())

  @@unique([userId, packageId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Single-use tokens for password reset and email verification. Only the SHA-256
// hash of the token is stored — the raw token exists only in the emailed link,
// so a database leak can't be used to reset accounts. Rows are deleted on use
// and expired ones are ignored (and swept opportunistically).
enum AuthTokenType {
  PASSWORD_RESET
  EMAIL_VERIFY
}

model AuthToken {
  id        String        @id @default(cuid())
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

// ---------------------------------------------------------------------------
// Paid subscriptions (Donor / Professional). One row per subscription instance,
// so canceled ones stay as history. Today driven by admin tier toggles; Stripe
// will create these rows later. priceCents = what the user pays per month.
model Subscription {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  tier       String // "DONOR" | "PRO"
  status     String    @default("ACTIVE") // "ACTIVE" | "CANCELED"
  priceCents Int
  startedAt  DateTime  @default(now())
  endedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Activity / audit log — one row per change or security-relevant event, for
// incident investigation. Written automatically by the Prisma extension in
// src/lib/audit.ts for every create/update/delete on audited models (with the
// before → after values of each changed field), plus explicit events for
// things that aren't row changes (logins, lockouts, denied actions…).
//
// Append-only: the migration adds a trigger that refuses UPDATE/DELETE on this
// table (except nulling actorId when a user row is removed), so nothing in the
// app — including an admin — can quietly rewrite history.
//
// Actor identity is denormalised (name + role at the time) so an entry still
// reads correctly after the person is renamed, demoted or deleted.
// ---------------------------------------------------------------------------
model AuditLog {
  id String   @id @default(cuid())
  at DateTime @default(now())

  // Groups every row written during one request / server action.
  requestId String?

  // Who
  actor      User?   @relation("AuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId    String?
  actorName  String? // forum name at the time
  actorRole  String? // USER | MODERATOR | ADMIN at the time; null = not signed in
  actingAsId String? // business the actor was "acting as", if any

  // What
  action      String // "User.update" | "Post.delete" | "auth.login.failed" | "access.denied" …
  severity    String  @default("info") // info | notice | warning
  outcome     String  @default("ok") // ok | denied | failed
  model       String? // Prisma model for row changes
  targetId    String? // primary key of the affected row (composite keys joined with ":")
  targetLabel String? // human handle at the time: title / forum name / slug …
  summary     String // one line: `role: USER → ADMIN · status: ACTIVE → ARCHIVED`
  changes     Json? // { field: { from, to } } — redacted, large values truncated
  snapshot    Json? // full row on create (after) / delete (before) — redacted
  meta        Json? // count for bulk ops, relation writes, denial reason, error code …

  // Where
  ip        String?
  country   String? // Cloudflare's cf-ipcountry, when present
  userAgent String?
  path      String? // page the action was submitted from

  @@index([at])
  @@index([actorId, at])
  @@index([model, targetId, at])
  @@index([action, at])
  @@index([severity, at])
  @@index([ip, at])
  @@index([requestId])
}
