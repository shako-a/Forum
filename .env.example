# Copy to .env and fill in. The real .env is gitignored.

# PostgreSQL connection string used by Prisma.
# Local dev: a plain local connection.
# Production (DigitalOcean): use the managed DB's connection string. For the app
# runtime prefer the POOLED (PgBouncer) connection; for `prisma migrate deploy`
# use the DIRECT connection. On App Platform this is injected automatically via
# the ${forum-db.DATABASE_URL} binding in .do/app.yaml.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/forum?schema=public"

# Secret used to sign session JWTs. Generate with: openssl rand -base64 32
# In production set this as an encrypted secret in the DO dashboard.
SESSION_SECRET="change-me-generate-with-openssl-rand-base64-32"

# --- Future (image uploads via DigitalOcean Spaces) -------------------------
# Not used yet. When post/ad-card image uploads land, add S3-compatible creds:
# SPACES_ENDPOINT="https://fra1.digitaloceanspaces.com"
# SPACES_REGION="fra1"
# SPACES_BUCKET="geoglobally-uploads"
# SPACES_KEY=""
# SPACES_SECRET=""

# --- Transactional email (Resend): password reset + email verification ------
# Both flows degrade gracefully until both are set. In dev, leave them blank —
# the reset/verify link is logged to the server console so you can follow it.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="GeoGlobally <noreply@send.geoglobally.com>"
# APP_URL="http://localhost:3000"   # canonical origin for links in emails

# --- Web analytics (self-hosted Umami) --------------------------------------
# The tracking beacon only renders when BOTH are set (no beacon otherwise).
# Umami is cookieless — no consent banner needed. Point UMAMI_SRC at your Umami
# server's script.js and paste the website UUID from its dashboard.
# UMAMI_SRC="https://analytics.geoglobally.com/script.js"
# UMAMI_WEBSITE_ID="00000000-0000-0000-0000-000000000000"
